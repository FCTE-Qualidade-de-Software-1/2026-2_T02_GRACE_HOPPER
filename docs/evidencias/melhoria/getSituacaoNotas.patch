+    /**
+     * Retorna os IDs dos componentes da matrícula que não são considerados para a progressão.
+     *
+     * @return array
+     */
+    private function _idsDisciplinasNaoReprovativas(array $componentesMatricula)
+    {
+        $naoReprovativas = array_filter($componentesMatricula, function ($componente) {
+            return $componente->desconsidera_para_progressao;
+        });
+
+        return array_map(function ($disciplina) {
+            return $disciplina->id;
+        }, $naoReprovativas);
+    }
+
+    /**
+     * Situação das notas quando a regra de avaliação usa uma nota geral por etapa: todos os
+     * componentes recebem a situação calculada a partir da média geral.
+     *
+     * @return stdClass
+     */
+    private function _situacaoNotasPorMediaGeral(stdClass $situacao, array $mediasComponentes)
+    {
+        $mediaGeral = $this->getMediaGeral();
+
+        if ($this->getRegraAvaliacaoTipoNota() == RegraAvaliacao_Model_Nota_TipoValor::NUMERICA) {
+            $media = $mediaGeral->mediaArredondada;
+        } else {
+            $media = $mediaGeral->media;
+        }
+
+        $situacaoGeral = $this->_situacaoPorMediaGeral($media, $mediaGeral->etapa);
+
+        foreach ($mediasComponentes as $id => $mediaComponente) {
+            $situacao->componentesCurriculares[$id] = new stdClass;
+            $situacao->componentesCurriculares[$id]->situacao = $situacaoGeral;
+        }
+
+        $situacao->situacao = $situacaoGeral;
+
+        return $situacao;
+    }
+
+    /**
+     * Converte a média geral e a etapa em que ela foi lançada na situação da matrícula.
+     *
+     * @return int
+     */
+    private function _situacaoPorMediaGeral($media, $etapa)
+    {
+        $ultimaEtapa = $etapa == $this->getOption('etapas');
+
+        if ($ultimaEtapa && $media < $this->getRegraAvaliacaoMedia()) {
+            return $this->hasRegraAvaliacaoFormulaRecuperacao()
+                ? App_Model_MatriculaSituacao::EM_EXAME
+                : App_Model_MatriculaSituacao::REPROVADO;
+        }
+
+        if ($etapa == 'Rc' && $media < $this->getRegraAvaliacaoMediaRecuperacao()) {
+            return $this->getRegraAvaliacaoAprovarPelaFrequenciaAposExame()
+                ? App_Model_MatriculaSituacao::APROVADO_APOS_EXAME
+                : App_Model_MatriculaSituacao::REPROVADO;
+        }
+
+        if ($etapa == 'Rc' && $media >= $this->getRegraAvaliacaoMediaRecuperacao() && $this->hasRegraAvaliacaoFormulaRecuperacao()) {
+            return App_Model_MatriculaSituacao::APROVADO_APOS_EXAME;
+        }
+
+        if ($etapa < $this->getOption('etapas') && $etapa != 'Rc') {
+            return App_Model_MatriculaSituacao::EM_ANDAMENTO;
+        }
+
+        return App_Model_MatriculaSituacao::APROVADO;
+    }
+
+    /**
+     * Indica se ainda faltam médias lançadas para que a situação da matrícula deixe de estar em andamento.
+     *
+     * @return bool
+     */
+    private function _lancamentoNotasIncompleto(
+        $calcularSituacaoAluno,
+        array $mediasComponentes,
+        array $mediasComponenentesTotal,
+        $componentes,
+        array $componentesMatricula,
+        $totalComponentes
+    ) {
+        if (empty($mediasComponenentesTotal) && count($componentesMatricula)) {
+            return true;
+        }
+
+        $componentePorEtapa = $this->getRegraAvaliacaoDefinirComponentePorEtapa() == '1';
+
+        if ($componentePorEtapa) {
+            return count($mediasComponentes) == 0 || count($mediasComponenentesTotal) < $totalComponentes;
+        }
+
+        if (!$calcularSituacaoAluno) {
+            // Se não tiver nenhuma média ou a quantidade for diferente dos componentes
+            // curriculares da matrícula, ainda está em andamento
+            return count($mediasComponentes) == 0 || count($mediasComponentes) != count($componentes);
+        }
+
+        return count($mediasComponenentesTotal) < $totalComponentes;
+    }
+
+    /**
+     * Situação de um componente quando a regra de avaliação usa progressão continuada.
+     *
+     * @return int
+     */
+    private function _situacaoComponenteProgressaoContinuada($matriculaId, $componenteId, $etapa, $lastStage)
+    {
+        $getCountNotaCC = App_Model_IedFinder::verificaSeExisteNotasComponenteCurricular($matriculaId, $componenteId);
+
+        if ($getCountNotaCC[0]['cc'] == 0) {
+            $etapa = 0;
+        }
+
+        if ($etapa < $lastStage && (string) $etapa != 'Rc') {
+            return App_Model_MatriculaSituacao::EM_ANDAMENTO;
+        }
+
+        return App_Model_MatriculaSituacao::APROVADO;
+    }
+
+    /**
+     * Situação de um componente a partir da sua média, da etapa da média e da regra de avaliação.
+     *
+     * Retorna um objeto com a situação do componente e com o indicador de componente em exame (0 ou 1).
+     *
+     * @return stdClass
+     */
+    private function _situacaoComponentePorNota($id, $mediaComponente, $media, $lastStage, array $disciplinasNaoReprovativas)
+    {
+        $resultado = new stdClass;
+        $resultado->emExame = 0;
+
+        $etapa = $mediaComponente->etapa;
+        $situacaoAtualComponente = $mediaComponente->situacao;
+        $permiteSituacaoEmExame = $situacaoAtualComponente != App_Model_MatriculaSituacao::REPROVADO
+            && $situacaoAtualComponente != App_Model_MatriculaSituacao::APROVADO;
+        $abaixoDaMedia = $etapa == $lastStage && $media < $this->getRegraAvaliacaoMedia();
+
+        if ($abaixoDaMedia && $this->hasRegraAvaliacaoFormulaRecuperacao() && $permiteSituacaoEmExame) {
+            $resultado->emExame = 1;
+            $resultado->situacao = $this->_reprovadoPelaPrevisaoDeRecuperacao($id)
+                ? App_Model_MatriculaSituacao::REPROVADO
+                : App_Model_MatriculaSituacao::EM_EXAME;
+
+            return $resultado;
+        }
+
+        if ($abaixoDaMedia) {
+            $resultado->situacao = App_Model_MatriculaSituacao::REPROVADO;
+
+            return $resultado;
+        }
+
+        if ((string) $etapa == 'Rc' && $media < $this->getRegraAvaliacaoMediaRecuperacao()) {
+            $resultado->situacao = $this->getRegraAvaliacaoAprovarPelaFrequenciaAposExame()
+                ? App_Model_MatriculaSituacao::APROVADO_APOS_EXAME
+                : App_Model_MatriculaSituacao::REPROVADO;
+
+            return $resultado;
+        }
+
+        if ((string) $etapa == 'Rc'
+            && $media >= $this->getRegraAvaliacaoMediaRecuperacao()
+            && $this->hasRegraAvaliacaoFormulaRecuperacao()) {
+            $resultado->situacao = App_Model_MatriculaSituacao::APROVADO_APOS_EXAME;
+        } elseif ($etapa < $lastStage && (string) $etapa != 'Rc' && !in_array($id, $disciplinasNaoReprovativas)) {
+            $resultado->situacao = App_Model_MatriculaSituacao::EM_ANDAMENTO;
+        } else {
+            $resultado->situacao = App_Model_MatriculaSituacao::APROVADO;
+        }
+
+        return $resultado;
+    }
