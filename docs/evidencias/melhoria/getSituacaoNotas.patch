+    /**
+     * Indica se a reprovação automática deve reprovar o componente em exame porque a nota
+     * prevista para a recuperação é maior que a nota máxima do exame final.
+     *
+     * @return bool
+     */
+    private function _reprovadoPelaPrevisaoDeRecuperacao($id)
+    {
+        if (!$this->hasRegraAvaliacaoReprovacaoAutomatica()) {
+            return false;
+        }
+
+        $previsaoRecuperacao = $this->preverNotaRecuperacao($id);
+
+        if (is_numeric($previsaoRecuperacao) && ($previsaoRecuperacao == '+' . $this->getRegraAvaliacaoNotaMaximaExameFinal())) {
+            return true;
+        }
+
+        return false;
+    }
