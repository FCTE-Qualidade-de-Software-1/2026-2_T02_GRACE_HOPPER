# Variáveis do docker-compose.yml da avaliação do i-Educar 2.12 (Issue #38 / M1 - TINCR).
# Copie para `.env` (instância padrão) ou use `--env-file config/instancia-b.env` (2ª instância).
# Cada variável abaixo corresponde a um recurso compartilhável inventariado em M1.

# Identidade da instância (prefixo de projeto, container_name e imagem)
COMPOSE_PROJECT_NAME=ieducar-a
INSTANCE_NAME=ieducar-a

# Checkout oficial do i-Educar (commit 7903a3efc7689942ee700007f86ed581023aad27)
IEDUCAR_SRC=./i-educar-src

# Portas publicadas no host
DOCKER_NGINX_PORT=8080
DOCKER_NGINX_SSL_PORT=8443
DOCKER_POSTGRES_PORT=5432
DOCKER_REDIS_PORT=6379

# Banco de dados PostgreSQL
DB_DATABASE=ieducar
DB_USERNAME=ieducar
DB_PASSWORD=ieducar

# Prefixo das chaves no Redis
REDIS_PREFIX=ieducar-a-

APP_URL=http://localhost:8080
HOST_UID=1001
HOST_GID=1001
